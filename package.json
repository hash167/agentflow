{
  "name": "agent-gateway",
  "version": "0.1.0",
  "description": "Self-hosted MCP agent gateway: one authenticated endpoint that aggregates upstream MCP servers with per-key tool policies and audit logging.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.13",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
