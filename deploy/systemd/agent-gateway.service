# Install:
#   sudo useradd -r -s /usr/sbin/nologin agentflow
#   sudo mkdir -p /opt/agentflow && sudo chown agentflow /opt/agentflow
#   go build -o /opt/agentflow/gateway ./cmd/gateway
#   go build -o /opt/agentflow/demo-upstream ./cmd/demo-upstream
#   sudo cp gateway.config.json /opt/agentflow/   # edit keys/upstreams first
#   sudo cp deploy/systemd/agent-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now agent-gateway
[Unit]
Description=Agent gateway (MCP tool plane)
After=network-online.target
Wants=network-online.target

[Service]
User=agentflow
WorkingDirectory=/opt/agentflow
ExecStart=/opt/agentflow/gateway /opt/agentflow/gateway.config.json
Restart=on-failure
RestartSec=5
# Put real API keys in this file as GATEWAY_*=... lines (chmod 600):
EnvironmentFile=-/etc/agentflow/gateway.env
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/agentflow

[Install]
WantedBy=multi-user.target
