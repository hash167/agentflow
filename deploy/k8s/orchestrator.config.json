{
  "temporal": {
    "hostPort": "temporal-frontend.temporal.svc.cluster.local:7233",
    "namespace": "default",
    "taskQueue": "code-review"
  },
  "webhook": {
    "host": "0.0.0.0",
    "port": 4819
  },
  "worker": {
    "maxConcurrentActivities": 4
  },
  "review": {
    "reviewerCommand": [
      "/app/cursor-reviewer"
    ],
    "maxDiffBytes": 300000,
    "sink": {
      "type": "github"
    },
    "reviewerTimeout": "12m",
    "activityTimeout": "15m"
  },
  "poller": {
    "enabled": true,
    "scheduleId": "pr-poller",
    "interval": "15m",
    "owner": "hash167",
    "includeDrafts": true,
    "repos": [],
    "excludeRepos": []
  }
}
